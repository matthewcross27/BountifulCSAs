# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local dev database (Stripe payments mirror; see lib/db)
/data/*.sqlite3*

# machine-local agent settings / symlinked skill copies (source of truth is .agents/skills)
.claude/settings.local.json
.claude/skills

# typescript
*.tsbuildinfo
next-env.d.ts
.DS_Store

# screencast-axi scratch: raw captures and the duration-measuring cache
# (deliverables live in public/demo and are committed)
/.screencast
